# ===== 应用 =====
ENV=development
SECRET_KEY=change-me-to-a-random-secret

# ===== 数据库 =====
DATABASE_URL=sqlite:///./data/app.db

# ===== Redis =====
REDIS_URL=redis://localhost:6379/0

# ===== 认证（切片 5a） =====
JWT_ACCESS_TTL_MIN=15
JWT_REFRESH_TTL_DAYS=7
CODE_TTL_SEC=300
CODE_SEND_COOLDOWN_SEC=60
CODE_MAX_ATTEMPTS=5

# ===== 邮件（验证码） =====
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=noreply@example.com

# ===== 内容安全审核 =====
MODERATION_API_KEY=
MODERATION_API_URL=

# ===== 前端 / CORS =====
FRONTEND_ORIGIN=http://localhost:3000

# ===== 清扫（切片 7，可选） =====
SWEEP_INTERVAL_MIN=10
SWEEP_FILE_RETENTION_MIN=60
SWEEP_STUCK_AFTER_MIN=120
SWEEP_ROW_RETENTION_DAYS=7

# ===== Docker 部署（切片 7，compose 读取） =====
# 对外地址：冒烟用 :80；生产设为域名（Caddy 自动 HTTPS，需放通 80/443）
SITE_ADDRESS=:80
# HTTP 端口映射（80 被占时可改 8080 等并用 http://localhost:8080 访问）
HTTP_PORT=80