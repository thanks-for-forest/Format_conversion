# ===== 应用 =====
ENV=development
SECRET_KEY=change-me-to-a-random-secret

# ===== 数据库 =====
DATABASE_URL=sqlite:///./data/app.db

# ===== Redis =====
REDIS_URL=redis://localhost:6379/0

# ===== 认证（切片 5a） =====
# 生产部署（ENV=production）必须改强随机值；弱默认值会拒绝启动（审计 L1）
JWT_ACCESS_TTL_MIN=15
JWT_REFRESH_TTL_DAYS=7
CODE_TTL_SEC=300
CODE_SEND_COOLDOWN_SEC=60
CODE_MAX_ATTEMPTS=5
# 同一 IP 每小时最多发码次数（审计 M1，防换邮箱刷码耗尽 SMTP 配额）
SEND_IP_HOURLY_LIMIT=10

# ===== 邮件（验证码） =====
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=noreply@example.com

# ===== 内容安全审核（切片 10d 骨架） =====
# 两个变量都配置 = 启用审核（fail-closed：服务商异常/未接入时所有上传被拒 451）；
# KEY 为空 = 未启用（跳过审核，启动 WARNING）。真服务商接入前请勿配置。
MODERATION_API_KEY=
MODERATION_API_URL=

# ===== 前端 / CORS =====
FRONTEND_ORIGIN=http://localhost:3000

# ===== 清扫（切片 7，可选） =====
SWEEP_INTERVAL_MIN=10
SWEEP_FILE_RETENTION_MIN=60
SWEEP_STUCK_AFTER_MIN=120
SWEEP_ROW_RETENTION_DAYS=7

# ===== 文档转换（切片 10a，可选） =====
# soffice 可执行文件路径；留空自动探测 PATH 与常见安装位置（Windows/Linux）
SOFFICE_PATH=
# 单个文档转换任务的子进程超时（秒）
SOFFICE_TIMEOUT_SEC=120

# ===== 音视频转换（切片 10b，可选） =====
# ffmpeg 可执行文件路径；留空自动探测 PATH 与常见安装位置（Windows/Linux）
FFMPEG_PATH=
# 单个音视频转换任务的子进程超时（秒）
FFMPEG_TIMEOUT_SEC=300

# ===== Docker 部署（切片 7，compose 读取） =====
# 对外地址：冒烟用 :80；生产设为域名（Caddy 自动 HTTPS，需放通 80/443）
SITE_ADDRESS=:80
# HTTP 端口映射（80 被占时可改 8080 等并用 http://localhost:8080 访问）
HTTP_PORT=80